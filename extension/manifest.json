{
  "manifest_version": 3,
  "name": "pravq go — Infinite Canvas",
  "version": "1.0.0",
  "description": "A ComfyUI-inspired infinite canvas workspace for notes, markdown, rich text, media, and search.",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "unlimitedStorage",
    "identity",
    "contextMenus"
  ],
  "oauth2": {
    "client_id": "550337992817-43kt8sikpoes8105nhvadns9blml53fj.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {},
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open Canvas"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
